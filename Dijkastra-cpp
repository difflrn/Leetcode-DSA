class Solution {
  public:
    vector<int> dijkstra(int V, vector<vector<int>> &edges, int source) {
        // prepare adjacency list 
        unordered_map<int , vector<pair<int, int>> > adj ;
        for ( int i = 0 ; i < edges.size() ; i++ ){
            int u = edges[i][0] ;
            int v = edges[i][1] ;
            int w = edges[i][2] ;
            
            adj[u].push_back({v, w}) ;
            adj[v].push_back({u, w}) ;
        }
        
        // create min heap 
        priority_queue< pair<int, int> , vector<pair<int, int>> , greater<pair<int, int>> > pq ;
        
        // create a vector to store the result  and store INFINITY weight/distance for each node from source node initially
        
        vector <int> ans (V ,INT_MAX) ;
        ans[source] = 0 ;
        pq.push({0 , source}) ;
        
        while (!pq.empty()){
            int d    = pq.top().first ;
            int node = pq.top().second ;
            pq.pop() ;
            
            for( auto vec : adj[node]) {
                int adjNode = vec.first ;
                int wt      = vec.second ;
                
                if( d+wt < ans[adjNode]) {
                    ans[adjNode] = d+wt ;
                    pq.push({d+wt , adjNode}) ;
                }
            }
        }
        return ans ;
    }
};
